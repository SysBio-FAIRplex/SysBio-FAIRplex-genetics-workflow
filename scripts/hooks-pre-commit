#!/bin/sh
# No stored notebook outputs (nb_guard.py), no participant-ID shapes (id_guard.py).
# Install after a fresh clone:
#   cp scripts/hooks-pre-commit .git/hooks/pre-commit && cp scripts/hooks-commit-msg .git/hooks/commit-msg
#   chmod +x .git/hooks/pre-commit .git/hooks/commit-msg
top="$(git rev-parse --show-toplevel)"
python3 "$top/scripts/nb_guard.py" --staged && exec python3 "$top/scripts/id_guard.py" --staged
